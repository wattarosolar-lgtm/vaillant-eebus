#!/command/with-contenv bashio
# shellcheck shell=bash
# Starts the Python backend. The s6 dependency on eebus-bridge only orders the
# start; the backend itself waits until the bridge's gRPC API answers.

LOG_LEVEL="$(bashio::config 'log_level')"
export LOG_LEVEL
# Must match grpc.port in ../eebus-bridge/run.
export BRIDGE_ADDRESS="127.0.0.1:50471"
# The bridge must report this serial, so the backend never talks to another
# EEBUS app's bridge by mistake.
export BRIDGE_SERIAL_FILE="/data/eebus/serial"
# TLS certificate and token of the bridge's gRPC API (oneshot init-grpc-credentials).
export BRIDGE_CREDENTIALS_DIR="/data/eebus/grpc"
export SHIP_PORT="4712"
export DATA_DIR="/data"
# Ingress: the Supervisor connects to the host's address in the hassio network
# and is the only accepted client. HTTP_PORT must match ingress_port in config.yaml.
export HTTP_HOST="172.30.32.1"
export HTTP_PORT="8714"
export TRUSTED_CLIENTS="172.30.32.2"

bashio::log.info "Starting backend"
exec /opt/venv/bin/python -m vaillant_eebus
